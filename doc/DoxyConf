DOXYFILE_ENCODING      = UTF-8
PROJECT_NAME           = "Secure Computation Library"
PROJECT_NUMBER         = 0.1
PROJECT_BRIEF          = "Utility library for Secure Computation Protocols."

OUTPUT_DIRECTORY       = ./doc

WARN_AS_ERROR          = NO

INPUT                  = doc/mainpage.md \
		         doc/docs.h \
                         include/scl/ \
                         include/scl/primitives \
                         include/scl/math \
                         include/scl/ss \
                         include/scl/net \
			 include/scl/net/tcp \
                         include/scl/simulation \
                         include/scl/coro

FILE_PATTERNS          = *.h
EXCLUDE_SYMBOLS        = SCL_*,details::*,*::details::*

REPEAT_BRIEF           = NO

SORT_MEMBER_DOCS       = NO
SORT_BRIEF_DOCS        = NO
SORT_MEMBERS_CTORS_1ST = YES

SHOW_USED_FILES        = NO
SHOW_FILES             = NO

USE_MDFILE_AS_MAINPAGE = doc/mainpage.md
HTML_EXTRA_STYLESHEET  = doc/styling.css
LAYOUT_FILE	       = doc/layout.xml

INLINE_INHERITED_MEMB  = YES
HTML_CODE_FOLDING      = NO

DISABLE_INDEX	       = NO
GENERATE_TREEVIEW      = NO

USE_MATHJAX            = YES

HAVE_DOT               = NO
GENERATE_LATEX         = NO
GENERATE_LEGEND        = NO
